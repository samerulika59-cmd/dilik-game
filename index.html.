<!DOCTYPE html>
<html lang="tg">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dilik Game</title>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-app.js"></script>
    <script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-database.js"></script>
    <style>
        body { background: #1a1a1a; color: white; font-family: sans-serif; text-align: center; margin: 0; display: flex; align-items: center; justify-content: center; height: 100vh; overflow: hidden; }
        #coinCount { font-size: 40px; color: #ffd700; margin-bottom: 20px; }
        #clicker { width: 220px; height: 220px; border-radius: 50%; cursor: pointer; transition: transform 0.1s; -webkit-tap-highlight-color: transparent; }
        #clicker:active { transform: scale(0.95); }
        .status { margin-top: 15px; font-size: 14px; color: #888; }
    </style>
</head>
<body>
    <div>
        <div id="coinCount">0</div>
        <img id="clicker" src="https://cdn-icons-png.flaticon.com/512/5968/5968310.png" alt="Coin">
        <div class="status" id="status">Пайвастшавӣ ба сервер...</div>
    </div>

    <script>
        // Танзимоти Firebase-и шумо
        const firebaseConfig = {
            apiKey: "AIzaSyBM9eh6zH_u0mk4G8YdZdyu0QFnw5bkbCI",
            authDomain: "dilik-game.firebaseapp.com",
            databaseURL: "https://dilik-game-default-rtdb.firebaseio.com",
            projectId: "dilik-game",
            storageBucket: "dilik-game.firebasestorage.app",
            messagingSenderId: "354871648694",
            appId: "1:354871648694:web:37372e8ef8dc33eaff2117"
        };

        firebase.initializeApp(firebaseConfig);
        const database = firebase.database();

        const tg = window.Telegram.WebApp;
        tg.expand();
        const userId = tg.initDataUnsafe.user ? tg.initDataUnsafe.user.id : "user_local";
        const userName = tg.initDataUnsafe.user ? tg.initDataUnsafe.user.first_name : "Меҳмон";

        let coins = 0;
        const coinDisplay = document.getElementById('coinCount');
        const statusDisplay = document.getElementById('status');
        const userRef = database.ref('users/' + userId);

        // Гирифтани тангаҳо аз сервер
        userRef.on('value', (snapshot) => {
            const data = snapshot.val();
            if (data) {
                coins = data.coins;
                coinDisplay.innerText = coins.toLocaleString();
                statusDisplay.innerText = "Хуш омадӣ, " + userName;
            } else {
                userRef.set({ name: userName, coins: 0 });
            }
        });

        // Функсияи клик
        document.getElementById('clicker').addEventListener('click', () => {
            coins++;
            coinDisplay.innerText = coins.toLocaleString();
            userRef.update({ coins: coins });
        });
    </script>
</body>
</html>
