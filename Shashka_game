<!DOCTYPE html>
<html lang="tg">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <title>CHINOOK OFFICIAL</title>
    <style>
        :root { --gold: #f1c40f; --dark: #1e272e; --wood: #3e2723; --win: #27ae60; --danger: #e74c3c; }
        
        /* Экрани оғоз */
        #splash {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: radial-gradient(circle, #2c3e50 0%, #000 100%);
            z-index: 5000; display: flex; flex-direction: column; align-items: center; justify-content: center;
            transition: opacity 1s ease;
        }
        .logo-anim { font-size: 50px; font-weight: 900; color: var(--gold); text-shadow: 0 0 25px rgba(241,196,15,0.6); animation: pulse 2s infinite; }
        @keyframes pulse { 0%, 100% { transform: scale(1); opacity: 0.7; } 50% { transform: scale(1.1); opacity: 1; } }

        body { background: #111; color: white; font-family: 'Segoe UI', Roboto, sans-serif; margin: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100vh; overflow: hidden; touch-action: none; }

        /* Менюи асосӣ */
        .overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.9); z-index: 1000; display: flex; align-items: center; justify-content: center; }
        .card { background: var(--dark); padding: 35px; border-radius: 25px; border: 2px solid var(--gold); text-align: center; width: 330px; box-shadow: 0 0 40px rgba(0,0,0,0.8); }
        .row { display: flex; justify-content: space-between; align-items: center; margin: 15px 0; font-size: 15px; }
        
        select, .btn-opt { padding: 10px; border-radius: 10px; border: none; background: #fff; font-weight: bold; width: 150px; cursor: pointer; }
        .btn-start { background: var(--gold); color: #000; padding: 18px; width: 100%; border-radius: 50px; border: none; font-size: 20px; font-weight: bold; cursor: pointer; margin-top: 25px; transition: 0.3s; }
        .btn-start:active { transform: scale(0.95); }

        /* Интерфейси бозӣ */
        .header { display: flex; gap: 20px; margin-bottom: 15px; font-weight: bold; background: rgba(255,255,255,0.1); padding: 10px 20px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.1); }
        #board-frame { padding: 15px; background: var(--wood); border-radius: 15px; box-shadow: 0 20px 50px rgba(0,0,0,0.9); border: 4px solid #2b1d1a; }
        #board { display: grid; grid-template-columns: repeat(8, 11.5vw); grid-template-rows: repeat(8, 11.5vw); max-width: 480px; border: 2px solid #000; }
        @media (min-width: 500px) { #board { grid-template-columns: repeat(8, 60px); grid-template-rows: repeat(8, 60px); } }

        .cell { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; position: relative; }
        .c-light { background: #e0c9a6; } .c-dark { background: #795548; }
        .last-move { background: rgba(241, 196, 15, 0.4) !important; }

        .piece { width: 85%; height: 85%; border-radius: 50%; cursor: pointer; position: relative; transition: 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275); z-index: 10; }
        .p-white { background: radial-gradient(circle at 30% 30%, #ffffff, #999); box-shadow: 0 5px 0 #777; }
        .p-black { background: radial-gradient(circle at 30% 30%, #444, #000); box-shadow: 0 5px 0 #000; }
        .king::after { content: '👑'; font-size: 24px; position: absolute; color: var(--gold); text-shadow: 0 2px 4px #000; width: 100%; text-align: center; top: 18%; }
        
        .selected { transform: scale(1.1) translateY(-8px); border: 4px solid #2ecc71; box-shadow: 0 15px 20px rgba(0,0,0,0.5); }
        .must-jump { box-shadow: 0 0 20px var(--danger) !important; animation: blink 0.8s infinite alternate; }
        @keyframes blink { from { opacity: 1; filter: brightness(1.2); } to { opacity: 0.6; filter: brightness(0.8); } }
    </style>
</head>
<body>

    <div id="splash"><div class="logo-anim">CHINOOK</div></div>

    <div id="main-menu" class="overlay" style="display:none;">
        <div class="card">
            <h1 style="color:var(--gold); margin:0; letter-spacing: 3px;">CHINOOK PRO</h1>
            <div style="font-size: 12px; color: #888; margin: 10px 0;">РЕКОРД: <span id="rec-w">0</span> В / <span id="rec-l">0</span> Б</div>
            <hr style="border: 0.5px solid #444; margin: 20px 0;">
            
            <div class="row"><span>Режим:</span><select id="m-mode"><option value="bot">БО БОТ</option><option value="friend">БО ДӮСТ</option></select></div>
            <div class="row"><span>Ба ақиб хӯрдан:</span><select id="m-back"><option value="yes">ИҶОЗАТ ✅</option><option value="no">МАНЪ ❌</option></select></div>
            <div class="row"><span>Садо:</span><button class="btn-opt" id="mute-btn" onclick="toggleMute()">ФАЪОЛ 🔊</button></div>
            
            <button class="btn-start" onclick="initGame()">ОҒОЗИ БОЗӢ</button>
        </div>
    </div>

    <div id="win-screen" class="overlay" style="display:none;">
        <div class="card"><h1 id="win-msg" style="color:var(--gold);"></h1><button class="btn-start" onclick="location.reload()">↩️ БОЗГАШТ</button></div>
    </div>

    <div class="header">
        <span>НАВБАТ: <b id="turn-txt" style="color:var(--gold)">САФЕД</b></span>
        <span>ҲИСОБ: <span id="live-w" style="color:var(--win)">0</span> - <span id="live-l" style="color:var(--danger)">0</span></span>
    </div>

    <div id="board-frame"><div id="board"></div></div>

    <script>
        let board = [], turn = 'white', selected = null, isMulti = false, lastPos = null;
        let conf = { mode: 'bot', mute: false, backJump: true };
        let stats = JSON.parse(localStorage.getItem('ck_stats')) || { w: 0, l: 0 };

        // Захираҳои аудиоӣ
        const sndJump = new Audio('https://assets.mixkit.co/active_storage/sfx/2571/2571-preview.mp3');
        const sndClick = new Audio('https://assets.mixkit.co/active_storage/sfx/2568/2568-preview.mp3');
        const bgMusic = new Audio('https://www.soundhelix.com/examples/mp3/SoundHelix-Song-8.mp3');
        bgMusic.loop = true; bgMusic.volume = 0.15;

        window.onload = () => {
            setTimeout(() => {
                document.getElementById('splash').style.opacity = '0';
                setTimeout(() => { 
                    document.getElementById('splash').style.display = 'none'; 
                    document.getElementById('main-menu').style.display = 'flex'; 
                }, 1000);
            }, 2500);
            updateStatsUI();
        };

        function toggleMute() { 
            conf.mute = !conf.mute; 
            document.getElementById('mute-btn').innerText = conf.mute ? "ХОМӮШ 🔇" : "ФАЪОЛ 🔊";
            conf.mute ? bgMusic.pause() : bgMusic.play();
        }

        function updateStatsUI() {
            document.getElementById('rec-w').innerText = stats.w; document.getElementById('rec-l').innerText = stats.l;
            document.getElementById('live-w').innerText = stats.w; document.getElementById('live-l').innerText = stats.l;
            localStorage.setItem('ck_stats', JSON.stringify(stats));
        }

        function initGame() {
            conf.mode = document.getElementById('m-mode').value;
            conf.backJump = document.getElementById('m-back').value === 'yes';
            document.getElementById('main-menu').style.display = 'none';
            if(!conf.mute) bgMusic.play().catch(() => {});
            board = Array.from({length:8}, (_,r)=>Array.from({length:8}, (_,c)=> (r+c)%2!==0 ? (r<3?{color:'black',king:false}:r>4?{color:'white',king:false}:null) : null));
            render();
        }

        function render() {
            const bEl = document.getElementById('board'); bEl.innerHTML = '';
            const allPossible = getAllMoves(turn);
            const hasJump = allPossible.some(m => m.jump);

            for(let r=0; r<8; r++) {
                for(let c=0; c<8; c++) {
                    const cell = document.createElement('div');
                    cell.className = `cell ${(r+c)%2===0?'c-light':'c-dark'} ${lastPos?.r===r && lastPos?.c===c ? 'last-move' : ''}`;
                    const p = board[r][c];
                    if(p) {
                        const div = document.createElement('div');
                        div.className = `piece p-${p.color} ${p.king?'king':''}`;
                        if(selected?.r===r && selected?.c===c) div.classList.add('selected');
                        if(!isMulti && hasJump && getMoves(r,c).some(m=>m.jump)) div.classList.add('must-jump');
                        div.onclick = () => { 
                            if(!isMulti && p.color===turn) { 
                                if(!conf.mute) { sndClick.currentTime = 0; sndClick.play(); }
                                selected={r,c}; render(); 
                            } 
                        };
                        cell.appendChild(div);
                    } else cell.onclick = () => handleMove(r, c);
                    bEl.appendChild(cell);
                }
            }
            document.getElementById('turn-txt').innerText = turn==='white'?'САФЕД':'СИЁҲ';
        }

        function handleMove(r2, c2) {
            if(!selected) return;
            const ms = getMoves(selected.r, selected.c);
            const m = ms.find(x => x.r2 === r2 && x.c2 === c2);
            if(getAllMoves(turn).some(x=>x.jump) && m && !m.jump) return;

            if(m) {
                const r1 = selected.r, c1 = selected.c, piece = board[r1][c1];
                board[r2][c2] = piece; board[r1][c1] = null;
                if(m.jump) { board[m.midR][m.midC] = null; if(!conf.mute) sndJump.play(); }
                if((piece.color==='white'&&r2===0) || (piece.color==='black'&&r2===7)) piece.king = true;
                lastPos = {r:r2, c:c2};

                if(m.jump && getMoves(r2, c2).some(x=>x.jump)) {
                    selected = {r:r2, c:c2}; isMulti = true;
                    if(turn==='black' && conf.mode==='bot') setTimeout(botMove, 600);
                } else {
                    isMulti = false; selected = null; turn = turn==='white'?'black':'white';
                    if(turn==='black' && conf.mode==='bot') setTimeout(botMove, 700);
                }
                render(); checkWinner();
            }
        }

        function getMoves(r, c) {
            const p = board[r][c]; if(!p) return [];
            let ms = [], dirs = [[1,1],[1,-1],[-1,1],[-1,-1]];
            dirs.forEach(d => {
                let nr = r + d[0], nc = c + d[1];
                if(p.king) {
                    let enemy = null;
                    while(nr >= 0 && nr < 8 && nc >= 0 && nc < 8) {
                        if(!board[nr][nc]) {
                            if(!enemy) ms.push({r2:nr, c2:nc, jump:false});
                            else ms.push({r2:nr, c2:nc, jump:true, midR:enemy.r, midC:enemy.c});
                        } else {
                            if(board[nr][nc].color === p.color) break;
                            if(enemy) break; enemy = {r:nr, c:nc};
                        }
                        nr += d[0]; nc += d[1];
                    }
                } else {
                    if(nr >= 0 && nr < 8 && nc >= 0 && nc < 8) {
                        if(!board[nr][nc]) {
                            if(d[0] === (p.color === 'white' ? -1 : 1)) ms.push({r2:nr, c2:nc, jump:false});
                        } else if(board[nr][nc].color !== p.color) {
                            let isForward = d[0] === (p.color === 'white' ? -1 : 1);
                            if(isForward || conf.backJump) {
                                let jr = nr + d[0], jc = nc + d[1];
                                if(jr >= 0 && jr < 8 && jc >= 0 && jc < 8 && !board[jr][jc])
                                    ms.push({r2:jr, c2:jc, jump:true, midR:nr, midC:nc});
                            }
                        }
                    }
                }
            });
            let jps = ms.filter(x=>x.jump); return jps.length ? jps : ms;
        }

        function getAllMoves(col) {
            let res = [];
            for(let r=0; r<8; r++) for(let c=0; c<8; c++) 
                if(board[r][c]?.color === col) getMoves(r,c).forEach(m => res.push({r1:r, c1:c, ...m}));
            let jps = res.filter(x=>x.jump); return jps.length ? jps : res;
        }

        function botMove() {
            const mv = getAllMoves('black'); if(!mv.length) return;
            const jumps = mv.filter(x=>x.jump);
            const m = jumps.length ? jumps[Math.floor(Math.random()*jumps.length)] : mv[Math.floor(Math.random()*mv.length)];
            selected = {r:m.r1, c:m.c1}; handleMove(m.r2, m.c2);
        }

        function checkWinner() {
            const w = getAllMoves('white'), b = getAllMoves('black');
            if(w.length===0 || b.length===0) {
                let win = w.length > 0;
                if(conf.mode==='bot') { if(win) stats.w++; else stats.l++; updateStatsUI(); }
                bgMusic.pause();
                document.getElementById('win-msg').innerText = win ? "ҒАЛАБА!" : "БОХТ!";
                document.getElementById('win-screen').style.display = 'flex';
            }
        }
    </script>
</body>
</html>
